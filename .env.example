# host ports (change if they are taken on your machine)
POSTGRES_PORT=5512
API_PORT=8190
# bearer token the quoting app sends on POST requests
PROPMEASURE_API_TOKEN=local-dev-token
# training length; the defaults reproduce the figures in the README
PROPMEASURE_BASE_STEPS=1500
PROPMEASURE_FT_STEPS=1000
